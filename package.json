{
  "name": "mediaplay",
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.mjs",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "desktop:preload": "bun build electron/preload.ts --target=node --format=cjs --packages=external --outfile=electron/preload.cjs",
    "desktop:dev": "bun run desktop:preload && node electron/launch.mjs",
    "desktop:preview": "next build --webpack && node electron/prepare.mjs && bun run desktop:preload && node electron/launch.mjs --production",
    "desktop:package": "next build --webpack && node electron/prepare.mjs && bun run desktop:preload && electron-builder"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@sonn-audio/node-upnp": "^0.4.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "music-metadata": "^12.3.2",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "node-drivelist": "^1.1.0",
    "platform-folders": "^0.6.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "platform-folders",
    "unrs-resolver"
  ]
}
